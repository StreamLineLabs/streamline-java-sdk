<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.streamline</groupId>
    <artifactId>streamline-java-parent</artifactId>
    <version>0.3.0</version>
    <packaging>pom</packaging>

    <name>Streamline Java SDK</name>
    <description>Native Java client library for Streamline streaming platform</description>
    <url>https://github.com/streamlinelabs/streamline-java-sdk</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Streamline Team</name>
            <email>team@streamlinelabs.dev</email>
            <organization>StreamlineLabs</organization>
            <organizationUrl>https://github.com/streamlinelabs</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/streamlinelabs/streamline-java-sdk.git</connection>
        <developerConnection>scm:git:git@github.com:streamlinelabs/streamline-java-sdk.git</developerConnection>
        <url>https://github.com/streamlinelabs/streamline-java-sdk</url>
    </scm>

    <modules>
        <module>streamline-client</module>
        <module>streamline-spring-boot-starter</module>
        <module>examples</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!--
          Test selection.

          Unit tests (surefire, `*Test`) are hermetic: they never contact a broker
          or an HTTP endpoint, so `mvn verify` is self-contained and bounded.

          Integration tests (failsafe, `*IT`) need a live Streamline server and are
          skipped unless the `integration` profile is active. The profile is
          activated explicitly with `-Pintegration` or implicitly by exporting
          `STREAMLINE_INTEGRATION=1`. The tests themselves additionally require
          `STREAMLINE_INTEGRATION=1`; see IntegrationEnvironment.
        -->
        <skipITs>true</skipITs>
        <surefire.version>3.2.2</surefire.version>
        <surefire.timeout>600</surefire.timeout>
        <failsafe.timeout>1800</failsafe.timeout>
        <!-- Resolved per module so SpotBugs works from the root or from a module directory. -->
        <spotbugs.excludeFilterFile>${project.basedir}/spotbugs-exclude.xml</spotbugs.excludeFilterFile>

        <!-- Dependency versions -->
        <slf4j.version>2.0.9</slf4j.version>
        <jackson.version>2.16.0</jackson.version>
        <kafka.version>3.7.0</kafka.version>
        <micrometer.version>1.12.0</micrometer.version>
        <spring-boot.version>3.2.0</spring-boot.version>

        <!-- Test dependency versions -->
        <junit.version>5.10.1</junit.version>
        <!-- 5.19+ bundles Byte Buddy 1.17.6+, the first release able to instrument JDK 25. -->
        <mockito.version>5.19.0</mockito.version>
        <!--
          spring-boot-dependencies manages Byte Buddy and pins an old line that cannot
          read modern class files ("Unknown Java version"), which silently breaks every
          Mockito test on a recent JDK. Manage it explicitly so Mockito gets its own.
        -->
        <byte-buddy.version>1.17.6</byte-buddy.version>
        <opentelemetry.version>1.34.0</opentelemetry.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Logging -->
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>

            <!-- JSON -->
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-core</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-annotations</artifactId>
                <version>${jackson.version}</version>
            </dependency>

            <!-- Metrics -->
            <dependency>
                <groupId>io.micrometer</groupId>
                <artifactId>micrometer-core</artifactId>
                <version>${micrometer.version}</version>
            </dependency>

            <!-- Spring Boot -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- OpenTelemetry (optional) -->
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-api</artifactId>
                <version>${opentelemetry.version}</version>
            </dependency>
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-context</artifactId>
                <version>${opentelemetry.version}</version>
            </dependency>

            <!-- Kafka Protocol -->
            <dependency>
                <groupId>org.apache.kafka</groupId>
                <artifactId>kafka-clients</artifactId>
                <version>${kafka.version}</version>
            </dependency>

            <!-- Testing -->
            <dependency>
                <groupId>net.bytebuddy</groupId>
                <artifactId>byte-buddy</artifactId>
                <version>${byte-buddy.version}</version>
            </dependency>
            <dependency>
                <groupId>net.bytebuddy</groupId>
                <artifactId>byte-buddy-agent</artifactId>
                <version>${byte-buddy.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.mockito</groupId>
                <artifactId>mockito-core</artifactId>
                <version>${mockito.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <distributionManagement>
        <snapshotRepository>
            <id>ossrh</id>
            <url>https://s01.oss.sonatype.org/content/repositories/snapshots</url>
        </snapshotRepository>
        <repository>
            <id>ossrh</id>
            <url>https://s01.oss.sonatype.org/service/local/staging/deploy/maven2/</url>
        </repository>
    </distributionManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.6.3</version>
                <executions>
                    <execution>
                        <id>enforce-maven-version</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>[3.9.0,)</version>
                                    <message>Streamline Java SDK requires Maven 3.9.0 or newer.</message>
                                </requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <!-- `release` also pins the API surface, so building on a newer JDK
                         cannot silently link against post-17 APIs. -->
                    <release>${java.version}</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
                <configuration>
                    <!--
                      Surefire's default includes already exclude `*IT` classes.
                      `integration` is excluded as well so that a tagged test can
                      never leak into the unit phase, whatever it is named.
                    -->
                    <excludedGroups>integration</excludedGroups>
                    <forkedProcessTimeoutInSeconds>${surefire.timeout}</forkedProcessTimeoutInSeconds>
                    <trimStackTrace>false</trimStackTrace>
                    <properties>
                        <!-- A hermetic unit test never needs 30s; anything slower is a smell. -->
                        <configurationParameters>
                            junit.jupiter.execution.timeout.default = 30 s
                        </configurationParameters>
                    </properties>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${surefire.version}</version>
                <configuration>
                    <skipITs>${skipITs}</skipITs>
                    <includes>
                        <include>**/*IT.java</include>
                    </includes>
                    <forkedProcessTimeoutInSeconds>${failsafe.timeout}</forkedProcessTimeoutInSeconds>
                    <trimStackTrace>false</trimStackTrace>
                    <properties>
                        <configurationParameters>
                            junit.jupiter.execution.timeout.default = 300 s
                        </configurationParameters>
                    </properties>
                </configuration>
                <executions>
                    <execution>
                        <id>integration-tests</id>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.13</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <!-- 4.9.x ships an ASM that can read JDK 21+ runtime class files. -->
                <version>4.9.8.5</version>
                <configuration>
                    <effort>Max</effort>
                    <threshold>Medium</threshold>
                    <failOnError>true</failOnError>
                    <excludeFilterFile>${spotbugs.excludeFilterFile}</excludeFilterFile>
                </configuration>
                <executions>
                    <execution>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          Integration tests (`*IT`) against a live Streamline server.

              STREAMLINE_INTEGRATION=1 mvn verify -Pintegration

          Endpoints are configurable (see IntegrationEnvironment):
            STREAMLINE_BOOTSTRAP_SERVERS  default localhost:9092
            STREAMLINE_HTTP_URL           default http://localhost:9094
            STREAMLINE_SCHEMA_REGISTRY_URL default ${STREAMLINE_HTTP_URL}
        -->
        <profile>
            <id>integration</id>
            <properties>
                <skipITs>false</skipITs>
            </properties>
        </profile>

        <!--
          Convenience activation so that an exported STREAMLINE_INTEGRATION=1 alone
          is enough to run the integration phase — `-Pintegration` stays optional.
        -->
        <profile>
            <id>integration-env</id>
            <activation>
                <property>
                    <name>env.STREAMLINE_INTEGRATION</name>
                    <value>1</value>
                </property>
            </activation>
            <properties>
                <skipITs>false</skipITs>
            </properties>
        </profile>

        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.0</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.6.3</version>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.plugins</groupId>
                        <artifactId>nexus-staging-maven-plugin</artifactId>
                        <version>1.6.13</version>
                        <extensions>true</extensions>
                        <configuration>
                            <serverId>ossrh</serverId>
                            <nexusUrl>https://s01.oss.sonatype.org/</nexusUrl>
                            <autoReleaseAfterClose>true</autoReleaseAfterClose>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>

